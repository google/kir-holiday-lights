// Copy to secrets.cue (which is gitignored) and put the real values in.
// Never commit secrets.cue.

// The "KIR Lights" WiFi password, for controllers that have a wlan0.
network: interfaces: wlan0?: psk: "change-me"

// The whole authorized_keys file for root and fpp on every controller: for
// example an SSH CA for a principal, and a recovery key.
sshKeys: [
	#"cert-authority,principals="me" ecdsa-sha2-nistp256 AAAA..."#,
	#"ssh-ed25519 AAAA... recovery"#,
]
